# Integration Test Environment Configuration (Container Mode)
# Based on local.env but configured for containerized integration testing with different ports

# Gatekeeper
LOG_LEVEL=INFO
CASBIN_LOG_LEVEL=WARN
SQLALCHEMY_LOG_LEVEL=WARN
ENVIRONMENT=integration-test
DEBUG=True
POSTGRES_HOST=datamap_postgres_test_integration
POSTGRES_USER=gk_admin
POSTGRES_PASSWORD=integration-test-postgres
POSTGRES_PORT=5432
POSTGRES_DB=gatekeeper_db
DATABASE_LOG_ENABLED=False
CASBIN_MODEL_FILE=app/resources/casbin_model.conf
AUTH_FILE_UPLOAD_TOKEN_SECRET=file-upload-fake-token
DATABASE_DOCKER_VOLUME=../db-data

# MIN.io (Internal container communication)
MINIO_ROOT_USER=gk_admin
MINIO_ROOT_PASSWORD=integration-test-minio
MINIO_URL=minio:9000
MINIO_ACCESS_KEY=gk_admin
MINIO_SECRET_KEY=integration-test-minio
MINIO_DATASET_BUCKET=datamap
MINIO_DEFAULT_REGION_ID='us-east-1'
STORAGE_DOCKER_VOLUME=../data-storage
MINIO_USE_SSL=False

# TUSd
AWS_ACCESS_KEY_ID=vmI02fswfhdHP1mmoASs
AWS_SECRET_ACCESS_KEY=NhZqdCsEDS6gLwcYXU6B48w244H7IA0GbYOoXWaC
AWS_REGION=us-east-1
TUS_HOOK_API=http://host.docker.internal:9093/api/v1/tus/hooks
TUS_S3_ENDPOINT=http://minio:9000

# DOI - WireMock Configuration (Internal container communication)
DOI_BASE_URL=http://datamap_wiremock_test_integration:8080
DOI_PREFIX=10.82978
DOI_LOGIN=MOCK_USER
DOI_PASSWORD=MOCK_PASS
DOI_TIMEOUT_SECONDS=2

# Integration Test Specific Configuration (External access)
INTEGRATION_BASE_URL=http://localhost:9094
INTEGRATION_TIMEOUT=30
INTEGRATION_API_KEY=5060b1a2-9aaf-48db-871a-0839007fd478
INTEGRATION_API_SECRET=integration-test-not-a-real-secret
INTEGRATION_USER_ID=cbb0a683-630f-4b86-8b45-91b90a6fce1c
INTEGRATION_TENANCY=datamap/production/data-amazon

# External port mappings for manual testing
# Gatekeeper API: http://localhost:9094
# MinIO Console: http://localhost:9003
# MinIO API: http://localhost:9002
# PostgreSQL: localhost:5433
# TUSd: http://localhost:1081
# WireMock Admin: http://localhost:8083

# Client secret hashing
AUTH_CLIENT_SECRET_PEPPER=integration-test-pepper-not-a-real-one
AUTH_PASSWORD_PEPPER=integration-test-password-pepper-not-a-real-one
AUTH_CHALLENGE_PEPPER=integration-test-challenge-pepper-not-a-real-one
ADMIN_NOTIFICATION_EMAILS=datamap-admins@fake.mail.com

# Email - Mailpit (Internal container communication)
EMAIL_ENABLED=True
EMAIL_FROM_NAME=DataMap
EMAIL_FROM_ADDRESS=no-reply@datamap.test
SMTP_HOST=datamap_mailpit_test_integration
SMTP_PORT=1025
SMTP_STARTTLS=False
SMTP_USERNAME=
SMTP_PASSWORD=
PUBLIC_BASE_URL=http://localhost:3000

# Mailpit HTTP API (External access)
MAILPIT_URL=http://localhost:8025
