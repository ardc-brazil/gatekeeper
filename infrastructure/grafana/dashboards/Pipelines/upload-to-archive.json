  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "A file's way through the platform: the browser uploads to **tusd**, which calls the gatekeeper's hook; publishing a version queues the dataset for **collocation**; the **archivist** moves its files into the sharded layout; a **snapshot** is written when a DOI is published; the **zipper** builds archives on request."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      }
    },
    {
      "type": "row",
      "title": "Uploads",
      "collapsed": false,
      "panels": [],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Hook errors in range",
      "description": "Each one is an upload the gatekeeper failed to record. UploadHooksFailing alerts on it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(datamap_tus_hook_total{outcome=\"error\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
