    {
      "type": "stat",
      "title": "Downloads completed in range",
      "description": "GETs to MinIO through nginx that were answered with data. A resumed or ranged download can count more than once.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({container=\"nginx\"} | json | uri=~\"/datamap/.*\" | status=~\"200|206\" | request_method=\"GET\" [$__range]))",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
