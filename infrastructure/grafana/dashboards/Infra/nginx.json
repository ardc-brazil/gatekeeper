    {
      "type": "timeseries",
      "title": "Response time p95 by area",
      "description": "request_time is from the first byte in to the last byte out, so a download measures the client's bandwidth as much as the server.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {container=\"nginx\"} | json | uri=~\"/api/.*\" | unwrap request_time [$__auto]) by (host)",
          "queryType": "range",
          "legendFormat": "api"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {container=\"nginx\"} | json | uri!~\"/(api|datamap|_next|grafana)/.*\" | unwrap request_time [$__auto]) by (host)",
          "queryType": "range",
          "legendFormat": "pages"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "quantile_over_time(0.95, {container=\"nginx\"} | json | uri=~\"/datamap/.*\" | unwrap request_time [$__auto]) by (host)",
          "queryType": "range",
          "legendFormat": "downloads"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
