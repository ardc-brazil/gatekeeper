    {
      "type": "timeseries",
      "title": "Requests / s by area",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (area) (rate({container=\"nginx\"} | json | label_format area=`{{ if hasPrefix \"/api/\" .uri }}api{{ else if hasPrefix \"/datamap/\" .uri }}downloads{{ else if hasPrefix \"/grafana\" .uri }}grafana{{ else if hasPrefix \"/_next/\" .uri }}static{{ else }}pages{{ end }}` [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{area}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
