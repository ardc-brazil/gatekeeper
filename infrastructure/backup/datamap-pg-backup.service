[Unit]
Description=Dump the DataMap database to the NAS
Documentation=https://github.com/ardc-brazil/gatekeeper/blob/main/docs/runbooks/database-backup.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=datamap
Group=datamap
# Not the runner's workspace: that directory belongs to CI and may be cleaned,
# and a backup that stops running because of a checkout is worse than none,
# because it looks installed. The deploy installs the script here.
ExecStart=/usr/bin/python3 /home/datamap/bin/backup_database.py \
    --output-dir /home/datamap/storage/backups/postgres \
    --keep-daily 30 \
    --keep-monthly 12
TimeoutStartSec=1800
