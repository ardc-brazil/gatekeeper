[Unit]
Description=Dump the DataMap database to the NAS
Documentation=https://github.com/ardc-brazil/gatekeeper/blob/main/docs/runbooks/database-backup.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=datamap
Group=datamap
WorkingDirectory=/home/datamap/actions-runner/_work/gatekeeper/gatekeeper
ExecStart=/usr/bin/python3 scripts/backup_database.py \
    --output-dir /home/datamap/storage/backups/postgres \
    --keep-daily 30 \
    --keep-monthly 12
TimeoutStartSec=1800
